# Copy to .env.production and fill in real values, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# NEVER commit the filled-in .env.production file — it stays out of git (see .gitignore).

# ============================================================================
# Reverse proxy / domain
# ============================================================================
# Must be a real domain already pointed (A/AAAA record) at this VPS — Caddy requests a Let's
# Encrypt certificate for it automatically on first start.
DOMAIN=academy.example.com
ACME_EMAIL=ops@example.com

# ============================================================================
# Database — self-hosted Postgres (the "postgres" service in docker-compose.prod.yml)
# ============================================================================
POSTGRES_USER=talent_prod
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=talent_prod
# Must match the three values above; the backend reads this one directly.
DATABASE_URL=postgresql+psycopg://talent_prod:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@postgres:5432/talent_prod

# ============================================================================
# Auth
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=15
STUDENT_REFRESH_TOKEN_DAYS=30
ADMIN_REFRESH_TOKEN_HOURS=12

# ============================================================================
# First (primary) admin bootstrap — only used once, on an empty database. See DEPLOYMENT.md
# "Creating/verifying the primary admin".
# ============================================================================
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_12_PLUS_CHARACTER_PASSWORD

# ============================================================================
# Frontend / CORS / cookies — FRONTEND_URL must be the real https:// domain; secure cookies and
# the CORS allow-list both derive from it.
# ============================================================================
FRONTEND_URL=https://academy.example.com
PUBLIC_DOMAIN=academy.example.com

# ============================================================================
# Live files storage — self-hosted MinIO (the "minio" service) by default. You can point this at
# real Cloudflare R2 instead if you'd rather not self-host it; either way it only needs to speak
# the S3 API.
# ============================================================================
MINIO_ROOT_USER=REPLACE_WITH_A_STRONG_RANDOM_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://minio:9000
R2_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ROOT_USER
R2_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
R2_BUCKET_FILES=talent-files
# Unused in this compose file (kept only so a shared .env works against docker-compose.dev.yml
# too) — the real backup destination is BACKUP_R2_* below, which must be a different provider/
# endpoint entirely.
R2_BUCKET_BACKUPS=talent-backups
R2_REGION=us-east-1

# ============================================================================
# Backup destination (Scope E) — a SECOND, genuinely external object store: a real Cloudflare R2
# bucket, Backblaze B2, AWS S3, etc. Must NOT be the same endpoint as R2_ENDPOINT_URL above —
# validate_for_production() refuses to start otherwise. Never point this at the VPS's own MinIO.
# ============================================================================
BACKUP_R2_ENDPOINT_URL=https://REPLACE.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=REPLACE_WITH_A_REAL_OFFSITE_ACCESS_KEY
BACKUP_R2_SECRET_ACCESS_KEY=REPLACE_WITH_A_REAL_OFFSITE_SECRET_KEY
BACKUP_R2_BUCKET=talent-backups-offsite
BACKUP_R2_REGION=auto

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=production
SEED_DEV_DATA=false
