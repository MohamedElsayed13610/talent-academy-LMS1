# Same-origin API through the Next.js proxy route (src/app/api/[...path]/route.ts).
NEXT_PUBLIC_API_URL=/api/v1

# Server-side only — where the proxy route forwards requests. In docker-compose.dev.yml this is
# the "backend" service name; in Railway it's the backend service's private network address.
BACKEND_INTERNAL_URL=http://localhost:8000
