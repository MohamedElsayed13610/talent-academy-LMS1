# Copy to backend/.env for local (non-Docker) runs. docker-compose.dev.yml sets its own values.

# --- Database (Railway managed PostgreSQL in production; docker-compose "postgres" service in dev) ---
DATABASE_URL=postgresql+psycopg://talent:talent@localhost:5432/talent

# --- Auth ---
# Long random secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-change-this-secret-key-please-replace
ACCESS_TOKEN_EXPIRE_MINUTES=15
STUDENT_REFRESH_TOKEN_DAYS=30
ADMIN_REFRESH_TOKEN_HOURS=12

# --- First admin bootstrap (only used on an empty database) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password

# --- Frontend / CORS ---
# The frontend calls the backend over Railway's private network in production, so this is mainly
# for local dev (frontend on a different port) and for the Origin check on unsafe requests.
FRONTEND_URL=http://localhost:3000

# --- Domain (Q1 — none yet; see docs/ARCHITECTURE.md A17) ---
# Leave empty until a custom domain exists. When set, it's used for cookie/CSP hardening.
PUBLIC_DOMAIN=

# --- Cloudflare R2 (S3-compatible). In dev, docker-compose points these at the local MinIO service. ---
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=talent-dev
R2_SECRET_ACCESS_KEY=talent-dev-secret
R2_BUCKET_FILES=talent-files
R2_BUCKET_BACKUPS=talent-backups
R2_REGION=auto

# --- Environment ---
ENVIRONMENT=development
SEED_DEV_DATA=true
